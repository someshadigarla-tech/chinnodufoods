# Chinnodu Foods - Environment Configuration Template
# Copy this file to .env and provide your private values.
# NEVER commit the real .env file to public version control.

# Server Environment
PORT=8080
NODE_ENV=production

# Database Configuration (MongoDB Atlas Cluster)
# Example: mongodb+srv://<db_user>:<db_password>@cluster0.abcde.mongodb.net/chinnodu_foods?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=chinnodu_foods

# Owner / Administrator Credentials
ADMIN_EMAIL=someshadigarla@gmail.com
ADMIN_PHONE=9676698427
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# SMS Gateway (Fast2SMS) API Key for 2FA OTP Delivery (Optional)
FAST2SMS_API_KEY=

# Local Development Debug Helpers (Strictly disabled in production)
ALLOW_DEV_OTP=false

# Allowed CORS Origins (Comma-separated)
ALLOWED_ORIGINS=https://chinnodufoods.com,https://www.chinnodufoods.com,https://someshadigarla-tech.github.io
